APP_ENV=production

# Database
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/zeeshop
JDBC_DATABASE_USERNAME=zeeshop_db
JDBC_DATABASE_PASSWORD=postgres
JDBC_DATABASE_DRIVER=org.postgresql.Driver

# Server
SERVER_PORT=8083

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT - Generated secure 256-bit secret key
JWT_SECRET=1a344ed3a2beda3ff7181d158af44e529debd473771a2bf78562dceccfc79aeb
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Seeded admin user
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@zeeshop.com
ADMIN_PASSWORD=Admin@000!

# Logging
LOG_LEVEL=INFO
SQL_LOG_LEVEL=INFO
LOG_FILE=logs/zeeshop-server.log
